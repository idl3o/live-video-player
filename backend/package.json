{
  "name": "backend",
  "version": "1.0.0",
  "description": "OBS-enabled live video player server (Express + Node-Media-Server + Helia)",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "live-streaming",
    "obs",
    "rtmp",
    "video-player"
  ],
  "license": "ISC",
  "dependencies": {
    "@helia/unixfs": "^5.0.0",
    "@openzeppelin/contracts": "^5.3.0",
    "@storacha/client": "^2.1.4",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "blockstore-fs": "^2.0.2",
    "cors": "^2.8.5",
    "datastore-fs": "^10.0.0",
    "dotenv": "^16.5.0",
    "ethers": "^5.7.2",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "file-type": "^18.7.0",
    "helia": "^5.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multiformats": "^13.3.0",
    "node-media-server": "^2.5.0",
    "siwe": "^3.0.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "viem": "^2.49.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.87",
    "@vitest/coverage-v8": "^4.1.6",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
