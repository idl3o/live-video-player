# =============================================================================
# Backend
# =============================================================================

# Server ports
PORT=45001
RTMP_PORT=45935
HTTP_PORT=45000

# JWT signing secret. MUST be overridden in production.
JWT_SECRET=change_me_in_production

# RTMP stream auth toggles
# STREAM_AUTH_PUBLISH=true   # default: require token to publish (OBS must include ?token=<jwt>)
# STREAM_AUTH_PLAY=false     # default: anyone can pull HTTP-FLV. Set true to require token.
# STREAM_SECRET=change_me_in_production

# ffmpeg binary path (Node-Media-Server uses this for mp4 recording).
# Leave unset to use the system 'ffmpeg' on PATH, or set explicitly.
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# =============================================================================
# Storacha (Filecoin-backed pinning for recordings)
# =============================================================================
# Set both to enable automatic Storacha upload after each recording.
#
# Provisioning (one time, on a trusted machine):
#   npm install -g @storacha/cli
#   storacha login your@email.com
#   storacha space create "live-video-player"
#   storacha key create    # → STORACHA_KEY (the agent's private key)
#   storacha delegation create $(storacha key get-did --key <key>) \
#     --base64 --can 'space/blob/add' --can 'space/index/add' \
#     --can 'filecoin/offer' --can 'upload/add'    # → STORACHA_PROOF
#
# STORACHA_KEY=
# STORACHA_PROOF=

# =============================================================================
# Frontend (Vite — must be prefixed VITE_)
# =============================================================================

# WalletConnect (Reown) project ID. Get one at https://cloud.reown.com.
# Required for RainbowKit / wagmi v2 to enable WalletConnect mobile pairing.
VITE_WALLETCONNECT_PROJECT_ID=

# Backend API target during dev (used by the Vite proxy).
# VITE_API_TARGET=http://localhost:45001

# Direct media base for the video player (HLS playlists + HTTP-FLV).
# Bypasses the Vite proxy so segment fetches don't go through dev middleware.
# VITE_FLV_BASE=http://localhost:45000

# Superfluid Super Token used for per-second payment streams. Must be a
# Pure Super Token (USDCx, ETHx, fUSDCx, etc.) deployed on Base Sepolia.
# Leave unset to disable payment streams in the UI.
# Example for testnet: VITE_PAYMENT_SUPER_TOKEN=0x143ea239159155b408e71cdbe836e8cfd6766732
# VITE_PAYMENT_SUPER_TOKEN=

# EAS attestation schemas on Base Sepolia. Register at
# https://base-sepolia.easscan.org/schema/create — paste the resulting UIDs here.
#
# Recommended schema strings:
#   StreamerEndorsement: "string role, string note"
#   ClipPraise:          "string contentCid, uint8 score, string note"
# VITE_EAS_STREAMER_ENDORSEMENT_SCHEMA=
# VITE_EAS_CLIP_PRAISE_SCHEMA=

# LiveStreamContent registry — anchors recording CIDs to creators on chain.
# Deploy via:
#   cd blockchain && npx hardhat ignition deploy ./ignition/modules/LiveStreamContent.ts --network baseSepolia
# then paste the resulting contract address here.
# VITE_LIVE_STREAM_CONTRACT=
