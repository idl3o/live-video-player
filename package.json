{
  "name": "live-video-player",
  "version": "1.0.0",
  "private": true,
  "description": "Decentralized open-source live streaming platform.",
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "node scripts/build.js",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "start:win": "powershell -ExecutionPolicy Bypass -File ./start-servers.ps1",
    "test:env:win": "powershell -ExecutionPolicy Bypass -File ./start-test-env.ps1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
